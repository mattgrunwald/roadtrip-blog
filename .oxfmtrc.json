{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "printWidth": 80,
  "ignorePatterns": [
    ".git",
    ".github",
    ".next",
    ".contentlayer",
    "geo/*.json",
    "public/images"
  ]
}
