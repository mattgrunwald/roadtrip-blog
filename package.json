{
  "name": "roadtrip-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . --config ./.prettierrc --ignore-path ./.prettierignore",
    "format:check": "prettier --check . --config ./.prettierrc --ignore-path ./.prettierignore",
    "prepare": "husky",
    "test": "jest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "contentlayer2": "^0.5.8",
    "github-slugger": "^2.0.0",
    "next": "^16.2.12",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.4.6",
    "postcss": "8.5.24",
    "react": "19.2.8",
    "react-calendar": "^6.0.1",
    "react-dom": "19.2.8",
    "react-simple-maps": "^3.0.0",
    "react-swipeable": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "baseline-browser-mapping": "^2.11.6",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,md,mdx}": "prettier --write --config ./.prettierrc --ignore-path ./.prettierignore",
    "*.{ts,tsx,js,jsx}": "eslint",
    "*.{ts,js}": "jest --findRelatedTests --passWithNoTests"
  },
  "overrides": {
    "d3-color": "3.1.0",
    "next-contentlayer": {
      "next": "$next"
    },
    "react-simple-maps": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-swipeable": {
      "react": "$react"
    },
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "contentlayer2",
      "esbuild",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}